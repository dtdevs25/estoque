# === Banco de Dados ===
DATABASE_URL=postgresql://postgres:senha@localhost:5432/db_estoque

# === Seed (only needed when running db:seed for the first time) ===
ADMIN_INITIAL_PASSWORD=coloque-uma-senha-forte-aqui
ADMIN_INITIAL_EMAIL=admin@suaempresa.com

# === JWT / Auth ===
JWT_SECRET=mude-esta-chave-para-uma-string-longa-e-aleatoria
AUTH_SECRET=mude-esta-chave-para-uma-string-longa-e-aleatoria
NEXTAUTH_URL=http://localhost:3001

# === S3 / Minio ===
S3_ENDPOINT=https://seu-minio.exemplo.com/
S3_KEY=sua-access-key
S3_SECRET=seu-secret-key
S3_REGION=us-east-1
S3_BUCKET=estoque-epi
S3_BUCKET_ERGONOMICOS=estoque-ergonomicos
S3_BUCKET_FOTOS=estoque-usuarios

# === Email (SMTP) ===
SMTP_HOST=mail.exemplo.com
SMTP_PORT=587
SMTP_USER=estoque@exemplo.com
SMTP_PASS=sua-senha-smtp

# === Integrações ===
N8N_WEBHOOK_ESTOQUE_BAIXO=https://seu-n8n.com/webhook/xxxxx
GEMINI_API_KEY=sua-chave-gemini
GROQ_API_KEY=sua-chave-groq

# === Ambiente ===
NODE_ENV=production
PORT=3001
